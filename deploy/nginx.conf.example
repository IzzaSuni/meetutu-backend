# /etc/nginx/sites-available/meetutu-backend
# Terminates TLS and proxies to the Node process on 127.0.0.1:8787.

server {
    listen 443 ssl http2;
    server_name api.meetutu.example;

    ssl_certificate     /etc/letsencrypt/live/api.meetutu.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.meetutu.example/privkey.pem;

    # A meeting part upload is a large body, and the browser sends the whole
    # recording; the 1m default rejects it outright.
    client_max_body_size 512m;
    client_body_timeout 300s;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Uploading and streaming audio should not be buffered to disk first.
        proxy_request_buffering off;
        proxy_buffering off;

        # Analysis kickoff returns immediately, but audio reads can be slow.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

server {
    listen 80;
    server_name api.meetutu.example;
    return 301 https://$host$request_uri;
}
