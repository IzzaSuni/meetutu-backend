# Copy to .env and fill in. Never commit the filled-in file.

# --- required ---------------------------------------------------------------
# Single-user login for the meetutu frontend.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
# OpenRouter key (https://openrouter.ai/keys). Required while AI_PROVIDER is
# openrouter; swap this for GEMINI_API_KEY if you set AI_PROVIDER=gemini.
OPENROUTER_API_KEY=

# --- optional ---------------------------------------------------------------
# Which provider handles a request that does not name one itself: openrouter or gemini.
AI_PROVIDER=openrouter
# Must accept audio input — the first pipeline step sends it the recording.
OPENROUTER_MODEL=google/gemini-3.8-flash
PORT=8787
HOST=0.0.0.0
# SQLite file and audio parts live here. Back this directory up.
DATA_DIR=./data
# Only needed when AI_PROVIDER=gemini, or for requests that ask for
# X-AI-Provider: gemini. Google Generative Language API key
# (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash
# Only when GEMINI_API_URL points at a Cloudflare AI Gateway.
CF_AIG_TOKEN=
# Comma-separated allowed origins. Narrow this to the frontend origin in production.
CORS_ORIGINS=*
